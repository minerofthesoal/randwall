<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="}DP57Xa.PvOCB0tbp7p{" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="yJa]:}j[|$(]ir5OB_R0"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace smartWalls {" line1="" line2="    export enum WallDirection {" line3="        //% block=&quot;all&quot;" line4="        All," line5="        //% block=&quot;left only&quot;" line6="        Left," line7="        //% block=&quot;right only&quot;" line8="        Right," line9="        //% block=&quot;up only&quot;" line10="        Up," line11="        //% block=&quot;down only&quot;" line12="        Down," line13="        //% block=&quot;left or right&quot;" line14="        LeftRight," line15="        //% block=&quot;up or down&quot;" line16="        UpDown" line17="    }" line18="" line19="    let currentDirection: WallDirection = WallDirection.All;" line20="    let wallProtection: boolean = false;" line21="" line22="    /**" line23="     * Set the wall direction using enum" line24="     */" line25="    //% block=&quot;set wall direction to %dir&quot;" line26="    export function setWallDirection(dir: WallDirection) {" line27="        currentDirection = dir;" line28="    }" line29="" line30="    /**" line31="     * New block: set wall direction via dropdown (N/E/S/W)" line32="     */" line33="    export enum CardinalDirection {" line34="        //% block=&quot;North&quot;" line35="        North," line36="        //% block=&quot;East&quot;" line37="        East," line38="        //% block=&quot;South&quot;" line39="        South," line40="        //% block=&quot;West&quot;" line41="        West" line42="    }" line43="" line44="    //% block=&quot;set wall direction using dropdown %dir&quot;" line45="    export function setWallDirectionDropdown(dir: CardinalDirection) {" line46="        switch (dir) {" line47="            case CardinalDirection.North: currentDirection = WallDirection.Up; break;" line48="            case CardinalDirection.East: currentDirection = WallDirection.Right; break;" line49="            case CardinalDirection.South: currentDirection = WallDirection.Down; break;" line50="            case CardinalDirection.West: currentDirection = WallDirection.Left; break;" line51="        }" line52="    }" line53="" line54="    /**" line55="     * Create a wall not in the given direction around the sprite" line56="     */" line57="    //% block=&quot;create wall not in direction of %sprite using %wallSprite&quot;" line58="    export function createWallNotInDirection(sprite: Sprite, wallSprite: Image) {" line59="        if (wallProtection) return;" line60="        wallProtection = true;" line61="" line62="        let dx = 0;" line63="        let dy = 0;" line64="" line65="        switch (currentDirection) {" line66="            case WallDirection.Left: dx = 1; break;" line67="            case WallDirection.Right: dx = -1; break;" line68="            case WallDirection.Up: dy = 1; break;" line69="            case WallDirection.Down: dy = -1; break;" line70="            case WallDirection.LeftRight: dx = Math.randomRange(0, 1) == 0 ? -1 : 1; break;" line71="            case WallDirection.UpDown: dy = Math.randomRange(0, 1) == 0 ? -1 : 1; break;" line72="            case WallDirection.All:" line73="            default:" line74="                dx = Math.randomRange(-1, 1);" line75="                dy = Math.randomRange(-1, 1);" line76="                break;" line77="        }" line78="" line79="        let x = sprite.x + dx * 16;" line80="        let y = sprite.y + dy * 16;" line81="" line82="        let wall = sprites.create(wallSprite.clone(), SpriteKind.Projectile);" line83="        wall.setPosition(x, y);" line84="        wall.setFlag(SpriteFlag.GhostThroughWalls, true);" line85="" line86="        // Flash red" line87="        let original = wall.image.clone();" line88="        let flashImage = original.clone();" line89="        flashImage.fill(2);" line90="        wall.setImage(flashImage);" line91="        pause(250);" line92="        wall.setImage(original);" line93="" line94="        pause(100);" line95="        wallProtection = false;" line96="    }" line97="" line98="    /**" line99="     * Create a wall not in direction using default wall sprite" line100="     */" line101="    //% block=&quot;create wall not in direction of %sprite using default wall&quot;" line102="    export function createWallDefault(sprite: Sprite) {" line103="        let defaultWall = img`" line104="            8888888888888888" line105="            8888888888888888" line106="            8888888888888888" line107="            8888888888888888" line108="            8888888888888888" line109="            8888888888888888" line110="            8888888888888888" line111="            8888888888888888" line112="            8888888888888888" line113="            8888888888888888" line114="            8888888888888888" line115="            8888888888888888" line116="            8888888888888888" line117="            8888888888888888" line118="            8888888888888888" line119="            8888888888888888" line120="        `;" line121="        createWallNotInDirection(sprite, defaultWall);" line122="    }" line123="" line124="    /**" line125="     * Demo setup: spawn default walls when player overlaps tile" line126="     */" line127="    //% block=&quot;setup demo for tile overlap example&quot;" line128="    export function setupDemo() {" line129="        scene.setBackgroundColor(9);" line130="        let player = sprites.create(img`" line131="            . . . . . . . ." line132="            . . 2 2 2 2 . ." line133="            . 2 2 2 2 2 2 ." line134="            . 2 2 2 2 2 2 ." line135="            . . 2 2 2 2 . ." line136="            . . . 2 2 . . ." line137="            . . . 2 2 . . ." line138="            . . . . . . . ." line139="        `, SpriteKind.Player);" line140="        controller.moveSprite(player)