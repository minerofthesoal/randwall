<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" x="10" y="10"><statement name="HANDLER"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace smartWalls {" line1="    export enum WallDirection {" line2="        //% block=&quot;all&quot;" line3="        All," line4="        //% block=&quot;left only&quot;" line5="        Left," line6="        //% block=&quot;right only&quot;" line7="        Right," line8="        //% block=&quot;up only&quot;" line9="        Up," line10="        //% block=&quot;down only&quot;" line11="        Down," line12="        //% block=&quot;left or right&quot;" line13="        LeftRight," line14="        //% block=&quot;up or down&quot;" line15="        UpDown" line16="    }" line17="" line18="    let currentDirection: WallDirection = WallDirection.All;" line19="    let wallProtection: boolean = false;" line20="" line21="    /**" line22="     * Set the wall direction to control where random walls can appear" line23="     */" line24="    //% block=&quot;set wall direction to %dir&quot;" line25="    export function setWallDirection(dir: WallDirection) {" line26="        currentDirection = dir;" line27="    }" line28="" line29="    /**" line30="     * Create a wall not in the given direction around the sprite" line31="     */" line32="    //% block=&quot;create wall not in direction of %sprite using %wallSprite&quot;" line33="    export function createWallNotInDirection(sprite: Sprite, wallSprite: Image) {" line34="        if (wallProtection) return;" line35="        wallProtection = true;" line36="" line37="        let dx = 0;" line38="        let dy = 0;" line39="" line40="        switch (currentDirection) {" line41="            case WallDirection.Left: dx = 1; break;" line42="            case WallDirection.Right: dx = -1; break;" line43="            case WallDirection.Up: dy = 1; break;" line44="            case WallDirection.Down: dy = -1; break;" line45="            case WallDirection.LeftRight: dx = Math.randomRange(0, 1) == 0 ? -1 : 1; break;" line46="            case WallDirection.UpDown: dy = Math.randomRange(0, 1) == 0 ? -1 : 1; break;" line47="            case WallDirection.All:" line48="            default:" line49="                dx = Math.randomRange(-1, 1);" line50="                dy = Math.randomRange(-1, 1);" line51="                break;" line52="        }" line53="" line54="        let x = sprite.x + dx * 16;" line55="        let y = sprite.y + dy * 16;" line56="" line57="        let wall = sprites.create(wallSprite.clone(), SpriteKind.Projectile);" line58="        wall.setPosition(x, y);" line59="        wall.setFlag(SpriteFlag.GhostThroughWalls, true);" line60="" line61="        // Flash red" line62="        let original = wall.image.clone();" line63="        let flashImage = original.clone();" line64="        flashImage.fill(2);" line65="        wall.setImage(flashImage);" line66="        pause(250);" line67="        wall.setImage(original);" line68="" line69="        pause(100);" line70="        wallProtection = false;" line71="    }" line72="" line73="    /**" line74="     * Create a wall not in direction using default wall sprite" line75="     */" line76="    //% block=&quot;create wall not in direction of %sprite using default wall&quot;" line77="    export function createWallDefault(sprite: Sprite) {" line78="        let defaultWall = img`" line79="            8888888888888888" line80="            8888888888888888" line81="            8888888888888888" line82="            8888888888888888" line83="            8888888888888888" line84="            8888888888888888" line85="            8888888888888888" line86="            8888888888888888" line87="            8888888888888888" line88="            8888888888888888" line89="            8888888888888888" line90="            8888888888888888" line91="            8888888888888888" line92="            8888888888888888" line93="            8888888888888888" line94="            8888888888888888" line95="        `;" line96="        createWallNotInDirection(sprite, defaultWall);" line97="    }" line98="" line99="    /**" line100="     * Demo setup: spawn default walls when player overlaps tile" line101="     */" line102="    //% block=&quot;setup demo for tile overlap example&quot;" line103="    export function setupDemo() {" line104="        scene.setBackgroundColor(9);" line105="        let player = sprites.create(img`" line106="            . . . . . . . ." line107="            . . 2 2 2 2 . ." line108="            . 2 2 2 2 2 2 ." line109="            . 2 2 2 2 2 2 ." line110="            . . 2 2 2 2 . ." line111="            . . . 2 2 . . ." line112="            . . . 2 2 . . ." line113="            . . . . . . . ." line114="        `, SpriteKind.Player);" line115="        controller.moveSprite(player);" line116="        scene.cameraFollowSprite(player);" line117="" line118="        scene.onOverlapTile(SpriteKind.Player, sprites.dungeon.floorLight0, function (sprite, location) {" line119="            createWallDefault(sprite);" line120="        });" line121="    }" line122="}" numlines="123"></mutation></block></statement></block></xml>